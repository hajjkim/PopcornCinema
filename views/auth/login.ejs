<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body class="page-auth">
  <main class="auth-page">
    <div class="auth-layout">
      <div class="auth-left">
        <div class="auth-brand">Popcorn Cinema</div>
        <h1>Xin chào!</h1>
        <p>Đăng nhập để đặt vé nhanh hơn, lưu lịch sử giao dịch và nhận ưu đãi thành viên.</p>
        <img src="/images/logo/logo.png" alt="Popcorn Cinema" class="auth-logo-image" />
      </div>

      <div class="auth-right">
        <div class="auth-card">
          <h2>Đăng nhập</h2>
          <p>Chào mừng bạn quay lại với Popcorn Cinema</p>

          <% if (error) { %>
            <div class="auth-error"><%= error %></div>
          <% } %>

          <form action="/auth/login" method="POST" class="auth-form">
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email" placeholder="Nhập email" required />
            </div>

            <div class="form-group">
              <label>Mật khẩu</label>
              <input type="password" name="password" placeholder="Nhập mật khẩu" required />
            </div>

            <button type="submit" class="auth-submit-btn">Đăng nhập</button>
          </form>

          <div class="auth-switch">
            Chưa có tài khoản?
            <a href="/auth/register">Đăng ký ngay</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>