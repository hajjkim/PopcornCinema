<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="admin-layout">
    <%- include("../partials/admin-sidebar", { currentPage: "movies" }) %>

    <main class="admin-content">
      <%- include("../partials/admin-topbar", {
        pageTitle: "Sửa phim",
        pageDescription: "Cập nhật thông tin phim",
        adminName: sessionUser ? sessionUser.fullName : "Admin"
      }) %>

      <section class="admin-page-section">
        <div class="admin-card">
          <form class="admin-form-grid" method="POST" action="/admin/movies/<%= movie.id %>/edit">
            <div class="admin-form-group">
              <label>Tên phim</label>
              <input type="text" name="title" value="<%= movie.title %>" required>
            </div>

            <div class="admin-form-group">
              <label>Thể loại</label>
              <input type="text" name="genre" value="<%= movie.genre %>" required>
            </div>

            <div class="admin-form-group">
              <label>Thời lượng (phút)</label>
              <input type="number" name="duration" value="<%= movie.duration %>" required>
            </div>

            <div class="admin-form-group">
              <label>Ngày khởi chiếu</label>
              <input type="date" name="release_date" value="<%= movie.release_date %>" required>
            </div>

            <div class="admin-form-group">
              <label>Trạng thái</label>
              <select name="status" required>
                <option value="NOW_SHOWING" <%= movie.status === "NOW_SHOWING" ? "selected" : "" %>>Đang chiếu</option>
                <option value="COMING_SOON" <%= movie.status === "COMING_SOON" ? "selected" : "" %>>Sắp chiếu</option>
              </select>
            </div>

            <div class="admin-form-group">
              <label>Poster URL</label>
              <input type="text" name="poster_url" value="<%= movie.poster_url %>">
            </div>

            <div class="admin-form-group">
              <label>Phân loại</label>
              <input type="text" name="age_rating" value="<%= movie.age_rating %>">
            </div>

            <div class="admin-form-group">
              <label>Đạo diễn</label>
              <input type="text" name="director" value="<%= movie.director %>">
            </div>

            <div class="admin-form-group">
              <label>Diễn viên</label>
              <input type="text" name="actors" value="<%= movie.actors %>">
            </div>

            <div class="admin-form-group">
              <label>Ngôn ngữ</label>
              <input type="text" name="language" value="<%= movie.language %>">
            </div>

            <div class="admin-form-group">
              <label>Phụ đề</label>
              <input type="text" name="subtitle" value="<%= movie.subtitle %>">
            </div>

            <div class="admin-form-group">
              <label>Trailer URL</label>
              <input type="text" name="trailer_url" value="<%= movie.trailer_url %>">
            </div>

            <div class="admin-form-group admin-form-group-full">
              <label>Mô tả</label>
              <textarea name="description" rows="5"><%= movie.description %></textarea>
            </div>

            <div class="admin-form-actions">
              <a href="/admin/movies/<%= movie.id %>" class="admin-btn admin-btn-outline">Hủy</a>
              <button type="submit" class="admin-btn admin-btn-primary">Cập nhật</button>
            </div>
          </form>
        </div>
      </section>
    </main>
  </div>
</body>
</html>