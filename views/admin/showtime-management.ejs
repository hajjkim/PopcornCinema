<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="admin-layout">
    <%- include("../partials/admin-sidebar", { currentPage: "showtimes" }) %>

    <main class="admin-content">
      <%- include("../partials/admin-topbar", {
        pageTitle: "Quản lý suất chiếu",
        pageDescription: "Quản lý lịch chiếu phim tại các rạp",
        adminName: sessionUser ? sessionUser.fullName : "Admin"
      }) %>

      <section class="admin-page-section">
        <div class="admin-page-actions">
          <a href="/admin/showtimes/create" class="admin-btn admin-btn-primary">+ Thêm suất chiếu</a>
        </div>

        <div class="admin-card">
          <form class="admin-filter-form admin-showtime-filter" method="GET" action="/admin/showtimes">
            <div class="admin-form-group">
              <label for="movie">Phim</label>
              <input
                type="text"
                id="movie"
                name="movie"
                placeholder="Nhập tên phim..."
                value="<%= movie || '' %>"
              />
            </div>

            <div class="admin-form-group">
              <label for="cinema">Rạp</label>
              <input
                type="text"
                id="cinema"
                name="cinema"
                placeholder="Nhập tên rạp..."
                value="<%= cinema || '' %>"
              />
            </div>

            <div class="admin-form-group">
              <label for="date">Ngày chiếu</label>
              <input
                type="date"
                id="date"
                name="date"
                value="<%= date || '' %>"
              />
            </div>

            <div class="admin-filter-actions">
              <button type="submit" class="admin-btn admin-btn-primary">Lọc</button>
              <a href="/admin/showtimes" class="admin-btn admin-btn-outline">Đặt lại</a>
            </div>
          </form>
        </div>

        <div class="admin-card">
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Phim</th>
                  <th>Rạp</th>
                  <th>Phòng</th>
                  <th>Ngày chiếu</th>
                  <th>Giờ bắt đầu</th>
                  <th>Giờ kết thúc</th>
                  <th>Định dạng</th>
                  <th>Trạng thái</th>
                  <th>Hành động</th>
                </tr>
              </thead>

              <tbody>
                <% if (showtimes && showtimes.length > 0) { %>
                  <% showtimes.forEach(item => { %>
                    <tr>
                      <td><%= item.id %></td>
                      <td>
                        <div class="admin-primary-cell">
                          <strong><%= item.movieTitle %></strong>
                        </div>
                      </td>
                      <td><%= item.cinemaName %></td>
                      <td><%= item.roomName %></td>
                      <td><%= item.showDate %></td>
                      <td><%= item.startTime %></td>
                      <td><%= item.endTime %></td>
                      <td><%= item.format %></td>
                      <td>
                        <% if (item.status === "OPEN") { %>
                          <span class="admin-badge admin-badge-success">Đang mở bán</span>
                        <% } else { %>
                          <span class="admin-badge admin-badge-danger">Đã đóng</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="admin-table-actions">
                          <a href="/admin/showtimes/<%= item.id %>/edit" class="admin-btn admin-btn-sm admin-btn-outline">Sửa</a>
                          <form action="/admin/showtimes/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa suất chiếu này?')">
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-danger">Xóa</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="10" class="admin-empty">Chưa có suất chiếu nào</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="admin-showtime-grid">
          <% if (showtimes && showtimes.length > 0) { %>
            <% showtimes.forEach(item => { %>
              <div class="admin-showtime-card">
                <div class="admin-showtime-card-top">
                  <h3><%= item.movieTitle %></h3>
                  <% if (item.status === "OPEN") { %>
                    <span class="admin-badge admin-badge-success">Đang mở bán</span>
                  <% } else { %>
                    <span class="admin-badge admin-badge-danger">Đã đóng</span>
                  <% } %>
                </div>

                <p><strong>Rạp:</strong> <%= item.cinemaName %></p>
                <p><strong>Phòng:</strong> <%= item.roomName %></p>
                <p><strong>Ngày:</strong> <%= item.showDate %></p>
                <p><strong>Giờ:</strong> <%= item.startTime %> - <%= item.endTime %></p>
                <p><strong>Định dạng:</strong> <%= item.format %></p>

                <div class="admin-showtime-card-actions">
                    <a href="/admin/showtimes/<%= item.id %>" class="admin-btn admin-btn-sm admin-btn-outline">Chi tiết</a>
                    <a href="/admin/showtimes/<%= item.id %>/edit" class="admin-btn admin-btn-sm admin-btn-outline">Sửa</a>

                    <form action="/admin/showtimes/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa suất chiếu này?')">
                        <button type="submit" class="admin-btn admin-btn-sm admin-btn-danger">Xóa</button>
                    </form>
                    </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </section>
    </main>
  </div>
</body>
</html>