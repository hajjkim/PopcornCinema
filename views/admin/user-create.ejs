<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="admin-layout">
    <%- include("../partials/admin-sidebar", { currentPage: "users" }) %>

    <main class="admin-content">
      <%- include("../partials/admin-topbar", {
        pageTitle: "Thêm người dùng",
        pageDescription: "Tạo tài khoản mới trong hệ thống",
        adminName: sessionUser ? sessionUser.fullName : "Admin"
      }) %>

      <section class="admin-page-section">
        <div class="admin-card">
          <form action="/admin/users/create" method="POST" class="admin-form-card">
            <div class="admin-form-grid">
              <div class="admin-form-group">
                <label for="fullName">Họ tên</label>
                <input type="text" id="fullName" name="fullName" required />
              </div>

              <div class="admin-form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
              </div>

              <div class="admin-form-group">
                <label for="phone">Số điện thoại</label>
                <input type="text" id="phone" name="phone" required />
              </div>

              <div class="admin-form-group">
                <label for="role">Vai trò</label>
                <select id="role" name="role" required>
                  <option value="CUSTOMER">Khách hàng</option>
                  <option value="STAFF">Nhân viên</option>
                  <option value="ADMIN">Admin</option>
                </select>
              </div>

              <div class="admin-form-group">
                <label for="status">Trạng thái</label>
                <select id="status" name="status" required>
                  <option value="ACTIVE">Hoạt động</option>
                  <option value="INACTIVE">Không hoạt động</option>
                  <option value="BLOCKED">Bị khóa</option>
                </select>
              </div>
            </div>

            <div class="admin-form-actions">
              <button type="submit" class="admin-btn admin-btn-primary">Thêm người dùng</button>
              <a href="/admin/users" class="admin-btn admin-btn-outline">Hủy</a>
            </div>
          </form>
        </div>
      </section>
    </main>
  </div>
</body>
</html>