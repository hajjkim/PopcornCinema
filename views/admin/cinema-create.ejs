<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="admin-layout">
    <%- include("../partials/admin-sidebar", { currentPage: "cinemas" }) %>

    <main class="admin-content">
      <%- include("../partials/admin-topbar", {
        pageTitle: "Thêm rạp phim",
        pageDescription: "Tạo mới rạp trong hệ thống",
        adminName: sessionUser ? sessionUser.fullName : "Admin"
      }) %>

      <section class="admin-page-section">
        <div class="admin-card">
          <form class="admin-form-grid" method="POST" action="/admin/cinemas/create">
            <div class="admin-form-group">
              <label>Tên rạp</label>
              <input type="text" name="name" required>
            </div>

            <div class="admin-form-group">
              <label>Thành phố</label>
              <input type="text" name="city" required>
            </div>

            <div class="admin-form-group admin-form-group-full">
              <label>Địa chỉ</label>
              <input type="text" name="address" required>
            </div>

            <div class="admin-form-group">
              <label>Số phòng</label>
              <input type="number" name="totalRooms" min="1" required>
            </div>

            <div class="admin-form-group">
              <label>Hotline</label>
              <input type="text" name="phone" required>
            </div>

            <div class="admin-form-group">
              <label>Trạng thái</label>
              <select name="status" required>
                <option value="ACTIVE">Hoạt động</option>
                <option value="INACTIVE">Tạm ngưng</option>
              </select>
            </div>

            <div class="admin-form-actions">
              <a href="/admin/cinemas" class="admin-btn admin-btn-outline">Hủy</a>
              <button type="submit" class="admin-btn admin-btn-primary">Lưu rạp</button>
            </div>
          </form>
        </div>
      </section>
    </main>
  </div>
</body>
</html>