<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="admin-layout">
    <%- include("../partials/admin-sidebar", { currentPage: "showtimes" }) %>

    <main class="admin-content">
      <%- include("../partials/admin-topbar", {
        pageTitle: "Sửa suất chiếu",
        pageDescription: "Cập nhật lịch chiếu phim",
        adminName: sessionUser ? sessionUser.fullName : "Admin"
      }) %>

      <section class="admin-page-section">
        <div class="admin-card">
          <form class="admin-form-grid" method="POST" action="/admin/showtimes/<%= showtime.id %>/edit">
            <div class="admin-form-group">
              <label>Tên phim</label>
              <input type="text" name="movieTitle" value="<%= showtime.movieTitle %>" required>
            </div>

            <div class="admin-form-group">
              <label>Rạp</label>
              <input type="text" name="cinemaName" value="<%= showtime.cinemaName %>" required>
            </div>

            <div class="admin-form-group">
              <label>Phòng</label>
              <input type="text" name="roomName" value="<%= showtime.roomName %>" required>
            </div>

            <div class="admin-form-group">
              <label>Ngày chiếu</label>
              <input type="date" name="showDate" value="<%= showtime.showDate %>" required>
            </div>

            <div class="admin-form-group">
              <label>Giờ bắt đầu</label>
              <input type="time" name="startTime" value="<%= showtime.startTime %>" required>
            </div>

            <div class="admin-form-group">
              <label>Giờ kết thúc</label>
              <input type="time" name="endTime" value="<%= showtime.endTime %>" required>
            </div>

            <div class="admin-form-group">
              <label>Định dạng</label>
              <input type="text" name="format" value="<%= showtime.format %>" required>
            </div>

            <div class="admin-form-group">
              <label>Trạng thái</label>
              <select name="status" required>
                <option value="OPEN" <%= showtime.status === "OPEN" ? "selected" : "" %>>Đang mở bán</option>
                <option value="CLOSED" <%= showtime.status === "CLOSED" ? "selected" : "" %>>Đã đóng</option>
              </select>
            </div>

            <div class="admin-form-actions">
              <a href="/admin/showtimes/<%= showtime.id %>" class="admin-btn admin-btn-outline">Hủy</a>
              <button type="submit" class="admin-btn admin-btn-primary">Cập nhật</button>
            </div>
          </form>
        </div>
      </section>
    </main>
  </div>
</body>
</html>